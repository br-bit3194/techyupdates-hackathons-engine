# =============================================================================
# TechyUpdates Hackathons Engine - Environment Variables Configuration
# =============================================================================

# 1. Google Gemini AI API Configuration (Required for AI extraction & tiering)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Telegram Community Channel Broadcast (Required for automated dispatch)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_COMMUNITY_CHANNEL_ID=@techy_jobs_updates

# 3. Security & Cron Secret (Optional, used for protecting HTTP trigger endpoints)
CRON_SECRET=your_secure_random_cron_secret_here

# 4. Pipeline Execution Options
DEBUG=False
BATCH_SIZE=50
REQUEST_TIMEOUT_SECONDS=8.0
